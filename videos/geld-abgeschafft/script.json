  "gap": 0.28,
  "lead_in": 0.35,
  "end_card": { "text": "FORTSETZUNG FOLGT …", "sub": "Was würdest du als Erstes tauschen?", "dur": 2.6 },
  "music": { "mood": "suspense", "bpm": 84 },
  "segments": [
    { "id": "bed",     "scene": "bed",     "chip": "TAG 1 · 06:58",
      "text": "Stell dir vor, du wachst morgen auf …",
