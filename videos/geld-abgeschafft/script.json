    { "id": "news",    "scene": "news",    "chip": "TAG 1 · 07:02",
      "text": "und überall steht nur ein Satz: Das Geld ist abgeschafft.",
      "hl": { "geld": "red", "abgeschafft": "red" }, "sfx": [["start", "ding"], ["w:satz", "ding"], ["w:abgeschafft", "impact"]] },

    { "id": "globe",   "scene": "globe",   "chip": "TAG 1 · 07:02",
      "text": "Kein Euro. Kein Dollar. Nichts. Weltweit, über Nacht.",
      "hl": { "euro": "blue", "dollar": "green", "nichts": "red", "weltweit": "yellow" },
      "sfx": [["w:euro", "pop"], ["w:dollar", "pop"], ["w:nichts", "glitch"]] },

    { "id": "bank",    "scene": "bank",    "chip": "TAG 1 · 07:05",
      "counter": { "label": "DEIN KONTOSTAND", "from": 2347.18, "to": 0, "fmt": "eur", "color": "red", "at": "w:null" },
